# Add a separate server block; do not replace the existing WordPress configuration.
# Point the subdomain's DNS at the droplet and obtain a valid TLS certificate first.
server {
    listen 80;
    server_name maths.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name maths.example.com;
    ssl_certificate /etc/letsencrypt/live/maths.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/maths.example.com/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
